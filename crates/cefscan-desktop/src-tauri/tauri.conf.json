{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cefscanw",
  "version": "0.1.0",
  "identifier": "io.github.cefscan.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "cefscanw — Chromium 内核应用扫描器",
        "width": 1180,
        "height": 760,
        "minWidth": 860,
        "minHeight": 520,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
